# Copy this file to .env  ( cp .env.example .env )  before running docker compose.
# The DB_* values below match the MySQL container defined in docker-compose.yml,
# so the app connects to the bundled database out of the box.

# --- Database (bundled MySQL container) ------------------------------------
DB_HOST=db
DB_USER=utp_user
DB_PASS=utp_password
DB_NAME=utp_vendor_hub
DB_PORT=3306

# --- Email / SMTP (Gmail app password) -------------------------------------
# Required only for features that send email. Leave blank to skip.
SMTP_USER=
SMTP_PASS=

# --- AWS S3 (document storage) ---------------------------------------------
# Required only for the file-upload-to-S3 features. Leave blank to skip.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET=
