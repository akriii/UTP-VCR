# Copy this file to .env  ( cp .env.example .env )  before running docker compose.
# The DB_* values below match the MySQL container defined in docker-compose.yml,
# so the app connects to the bundled database out of the box.

# --- Database (bundled MySQL container) ------------------------------------
DB_HOST=db
DB_USER=utp_user
DB_PASS=utp_password
DB_NAME=utp_vendor_hub
DB_PORT=3306

# --- Email / SMTP (Gmail app password) -------------------------------------
# Required only for features that send email. Leave blank to skip.
SMTP_USER=
SMTP_PASS=

# --- AWS S3 (document storage) ---------------------------------------------
# REQUIRED. Every uploaded document (IC copies, bank statements, declaration
# forms, KYC6 reports, generated ZIPs...) is stored in this bucket.
# AWS_REGION must be the region the bucket actually lives in - verify with:
#     php tools/s3_check.php
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_BUCKET=

# Secret used to sign the /file.php document links so a signed-in user cannot
# guess another applicant's documents. Any long random string will do.
# If left blank the app falls back to deriving one from the keys above.
APP_SECRET=
