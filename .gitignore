# Composer Dependencies
/vendor

# Environment Variables (Sensitive Passwords)
.env

# System Generated Files & User Uploads
# Uploads now go to the S3 bucket named by AWS_BUCKET, not to disk.
# These folders only hold pre-migration leftovers (see tools/migrate_documents_to_s3.php)
# and are kept ignored so nothing sensitive can be committed by accident.
/documents/generated_zips/*
!/documents/generated_zips/.gitkeep

# Specific Document Folders (Based on your file structure)
/documents/kyc6/*
!/documents/kyc6/.gitkeep

/documents/bank_statement/*
!/documents/bank_statement/.gitkeep

/documents/declaration_form/*
!/documents/declaration_form/.gitkeep

/documents/fyp_form_file/*
!/documents/fyp_form_file/.gitkeep

/documents/appointment_file/*
!/documents/appointment_file/.gitkeep

/documents/ic_picture/*
!/documents/ic_picture/.gitkeep

/documents/face_captures/*
!/documents/face_captures/.gitkeep

# OS generated files
.DS_Store
Thumbs.db